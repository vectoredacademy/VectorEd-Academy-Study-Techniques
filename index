    function renderQuestion() {
      const q = shuffledQuestions[currentQuestionIndex];
      const total = shuffledQuestions.length;

      const progressPct = Math.round(((currentQuestionIndex + 1) / total) * 100);
      document.getElementById('progressBar').style.width = `${progressPct}%`;
      document.getElementById('progressPercent').textContent = `${progressPct}%`;
      document.getElementById('quizCounterText').textContent = `Question ${currentQuestionIndex + 1} of ${total}`;

      document.getElementById('questionCategory').innerHTML = q.category[currentLang] || q.category['EN'];
      document.getElementById('questionText').innerHTML = q.questionText[currentLang] || q.questionText['EN'];

      const container = document.getElementById('optionsContainer');
      container.innerHTML = '';

      const badgeLetters = ['A', 'B', 'C', 'D'];

      q.options.forEach((opt, idx) => {
        const isSelected = selectedAnswers[currentQuestionIndex] === opt.key;
        const card = document.createElement('div');
        card.className = `option-card p-3.5 sm:p-4 rounded-xl border bg-slate-900/90 flex items-start space-x-3 sm:space-x-3.5 text-left cursor-pointer transition-all duration-200 ${isSelected ? 'selected border-amber-500 bg-amber-500/10 shadow-md shadow-amber-500/10' : 'border-slate-700/80 hover:border-amber-500/50 hover:bg-slate-800/60'}`;
        card.onclick = () => selectOption(opt.key);

        const rawText = opt.text[currentLang] || opt.text['EN'] || '';
        const cleanText = rawText.trim().replace(/^\n+|\n+$/g, '');

        card.innerHTML = `
          <span class="flex-shrink-0 w-7 h-7 sm:w-8 sm:h-8 rounded-lg ${isSelected ? 'bg-amber-500 text-slate-950 font-extrabold border-amber-400' : 'bg-slate-800 text-slate-300 font-bold border-slate-700'} flex items-center justify-center text-xs sm:text-sm border transition-colors mt-0.5 select-none">
            ${badgeLetters[idx]}
          </span>
          <span class="flex-1 min-w-0 text-xs sm:text-sm text-slate-200 leading-normal sm:leading-relaxed font-normal formatted-content">
            ${cleanText}
          </span>
        `;
        container.appendChild(card);
      });

      document.getElementById('prevBtn').disabled = (currentQuestionIndex === 0);

      const nextBtn = document.getElementById('nextBtn');
      const hasSelected = selectedAnswers[currentQuestionIndex] !== null;
      nextBtn.disabled = !hasSelected;

      if (currentQuestionIndex === total - 1) {
        document.getElementById('nextBtnText').textContent = currentLang === 'EN' ? 'Finish Diagnostic 🚀' : 'Tapusin ang Diagnostic 🚀';
        document.getElementById('nextBtnIcon').className = 'fa-solid fa-check-double ml-1';
      } else {
        document.getElementById('nextBtnText').textContent = currentLang === 'EN' ? 'Next Question' : 'Susunod na Tanong';
        document.getElementById('nextBtnIcon').className = 'fa-solid fa-arrow-right ml-1';
      }
    }

    function selectOption(key) {
      selectedAnswers[currentQuestionIndex] = key;
      renderQuestion();
    }

    function nextQuestion() {
      if (selectedAnswers[currentQuestionIndex] === null) return;
      if (currentQuestionIndex < shuffledQuestions.length - 1) {
        currentQuestionIndex++;
        renderQuestion();
      } else {
        finishDiagnostic();
      }
    }

    function prevQuestion() {
      if (currentQuestionIndex > 0) {
        currentQuestionIndex--;
        renderQuestion();
      }
    }

    function calculateArchetype() {
      const counts = { A: 0, B: 0, C: 0, D: 0 };
      selectedAnswers.forEach(ans => {
        if (ans && counts[ans] !== undefined) counts[ans]++;
      });

      for (const key of ['A', 'B', 'C', 'D']) {
        if (counts[key] >= 3) return key;
      }
      const q5Answer = selectedAnswers[4];
      if (q5Answer) return q5Answer;
      return 'A';
    }

    function finishDiagnostic() {
      calculatedArchetypeKey = calculateArchetype();

      renderResult();
