                  <button type="button" onclick="insertFormattingTag('${sumEnId}','bold')" class="px-1.5 py-0.5 text-[9px] bg-slate-800 text-amber-400 rounded hover:bg-slate-700">Bold</button>
                  <button type="button" onclick="insertFormattingTag('${sumEnId}','italic')" class="px-1.5 py-0.5 text-[9px] bg-slate-800 text-amber-400 rounded hover:bg-slate-700">Italic</button>
                </div>
              </div>
              <textarea id="${sumEnId}" rows="3" class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white focus:outline-none focus:border-amber-500">${arch.summary.EN}</textarea>
            </div>
            <div>
              <div class="flex justify-between items-center mb-1">
                <label class="block text-[10px] text-slate-400 uppercase font-semibold">Summary (Taglish)</label>
                <div class="space-x-1">
                  <button type="button" onclick="insertFormattingTag('${sumTlId}','bold')" class="px-1.5 py-0.5 text-[9px] bg-slate-800 text-amber-400 rounded hover:bg-slate-700">Bold</button>
                  <button type="button" onclick="insertFormattingTag('${sumTlId}','italic')" class="px-1.5 py-0.5 text-[9px] bg-slate-800 text-amber-400 rounded hover:bg-slate-700">Italic</button>
                </div>
              </div>
              <textarea id="${sumTlId}" rows="3" class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white focus:outline-none focus:border-amber-500">${arch.summary.TL}</textarea>
            </div>
          </div>

          <!-- TECHNIQUE 1 EDITORS -->
          <div class="border-t border-slate-800/80 pt-2 mt-2">
            <h5 class="text-[10px] text-slate-300 font-bold mb-2">Column 1: Strategy</h5>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-2">
              <input type="text" id="${t1TitleEnId}" value="${arch.tech1Title.EN}" placeholder="Tech 1 Title (EN)" class="w-full px-2 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white">
              <input type="text" id="${t1TitleTlId}" value="${arch.tech1Title.TL}" placeholder="Tech 1 Title (TL)" class="w-full px-2 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white">
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <textarea id="${t1DescEnId}" rows="2" placeholder="Tech 1 Desc (EN)" class="w-full px-2 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white focus:border-amber-500">${arch.tech1Desc.EN}</textarea>
              <textarea id="${t1DescTlId}" rows="2" placeholder="Tech 1 Desc (TL)" class="w-full px-2 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white focus:border-amber-500">${arch.tech1Desc.TL}</textarea>
            </div>
          </div>

          <!-- TECHNIQUE 2 EDITORS -->
          <div class="border-t border-slate-800/80 pt-2 mt-2">
            <h5 class="text-[10px] text-slate-300 font-bold mb-2">Column 2: Strategy</h5>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-2">
              <input type="text" id="${t2TitleEnId}" value="${arch.tech2Title.EN}" placeholder="Tech 2 Title (EN)" class="w-full px-2 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white">
              <input type="text" id="${t2TitleTlId}" value="${arch.tech2Title.TL}" placeholder="Tech 2 Title (TL)" class="w-full px-2 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white">
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <textarea id="${t2DescEnId}" rows="2" placeholder="Tech 2 Desc (EN)" class="w-full px-2 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white focus:border-amber-500">${arch.tech2Desc.EN}</textarea>
              <textarea id="${t2DescTlId}" rows="2" placeholder="Tech 2 Desc (TL)" class="w-full px-2 py-1.5 bg-slate-900 border border-slate-700 rounded text-xs text-white focus:border-amber-500">${arch.tech2Desc.TL}</textarea>
            </div>
          </div>
        `;
        container.appendChild(archBox);
      });
    }

    function renderAdminCtasEditor() {
      document.getElementById('admin_fb_connect_text').value = fbCtaConfig.text;
      document.getElementById('admin_fb_connect_url').value = fbCtaConfig.url;

      document.getElementById('admin_masterpack_title').value = masterpackConfig.title;
      document.getElementById('admin_masterpack_instruction').value = masterpackConfig.instruction;

      document.getElementById('admin_teaser_title').value = teaserConfig.title;
      document.getElementById('admin_teaser_text').value = teaserConfig.text;

      document.getElementById('admin_action_btn_text').value = actionBtnConfig.text;
      document.getElementById('admin_action_btn_url').value = actionBtnConfig.url;

      document.getElementById('admin_retake_btn_text').value = retakeBtnConfig.text;
    }

    function saveAdminContentChanges() {
      quizQuestions.forEach((q, idx) => {
        const catEnInput = document.getElementById(`admin_cat_en_${idx}`);
        const catTlInput = document.getElementById(`admin_cat_tl_${idx}`);
        const qTextEnInput = document.getElementById(`admin_qtext_en_${idx}`);
        const qTextTlInput = document.getElementById(`admin_qtext_tl_${idx}`);

        if (catEnInput) q.category.EN = catEnInput.value.trim();
        if (catTlInput) q.category.TL = catTlInput.value.trim();
        if (qTextEnInput) q.questionText.EN = qTextEnInput.value.trim();
        if (qTextTlInput) q.questionText.TL = qTextTlInput.value.trim();

        q.options.forEach((opt, optIdx) => {
          const optEnInput = document.getElementById(`admin_opt_${idx}_${optIdx}_en`);
          const optTlInput = document.getElementById(`admin_opt_${idx}_${optIdx}_tl`);
          if (optEnInput) opt.text.EN = optEnInput.value.trim();
          if (optTlInput) opt.text.TL = optTlInput.value.trim();
        });
      });

      ['A', 'B', 'C', 'D'].forEach(key => {
        const sumEn = document.getElementById(`admin_arch_sum_en_${key}`);
        const sumTl = document.getElementById(`admin_arch_sum_tl_${key}`);
        
        const t1TitleEn = document.getElementById(`admin_arch_t1title_en_${key}`);
        const t1TitleTl = document.getElementById(`admin_arch_t1title_tl_${key}`);
        const t1DescEn = document.getElementById(`admin_arch_t1desc_en_${key}`);
        const t1DescTl = document.getElementById(`admin_arch_t1desc_tl_${key}`);
        
        const t2TitleEn = document.getElementById(`admin_arch_t2title_en_${key}`);
        const t2TitleTl = document.getElementById(`admin_arch_t2title_tl_${key}`);
        const t2DescEn = document.getElementById(`admin_arch_t2desc_en_${key}`);
        const t2DescTl = document.getElementById(`admin_arch_t2desc_tl_${key}`);

        if (sumEn && archetypeData[key]) archetypeData[key].summary.EN = sumEn.value.trim();
        if (sumTl && archetypeData[key]) archetypeData[key].summary.TL = sumTl.value.trim();

        if (t1TitleEn && archetypeData[key]) archetypeData[key].tech1Title.EN = t1TitleEn.value.trim();
        if (t1TitleTl && archetypeData[key]) archetypeData[key].tech1Title.TL = t1TitleTl.value.trim();
        if (t1DescEn && archetypeData[key]) archetypeData[key].tech1Desc.EN = t1DescEn.value.trim();
        if (t1DescTl && archetypeData[key]) archetypeData[key].tech1Desc.TL = t1DescTl.value.trim();

        if (t2TitleEn && archetypeData[key]) archetypeData[key].tech2Title.EN = t2TitleEn.value.trim();
        if (t2TitleTl && archetypeData[key]) archetypeData[key].tech2Title.TL = t2TitleTl.value.trim();
        if (t2DescEn && archetypeData[key]) archetypeData[key].tech2Desc.EN = t2DescEn.value.trim();
        if (t2DescTl && archetypeData[key]) archetypeData[key].tech2Desc.TL = t2DescTl.value.trim();
      });

      fbCtaConfig.text = document.getElementById('admin_fb_connect_text').value.trim();
      fbCtaConfig.url = document.getElementById('admin_fb_connect_url').value.trim();

      masterpackConfig.title = document.getElementById('admin_masterpack_title').value.trim();
      masterpackConfig.instruction = document.getElementById('admin_masterpack_instruction').value.trim();

      teaserConfig.title = document.getElementById('admin_teaser_title').value.trim();
      teaserConfig.text = document.getElementById('admin_teaser_text').value.trim();

      actionBtnConfig.text = document.getElementById('admin_action_btn_text').value.trim();
      actionBtnConfig.url = document.getElementById('admin_action_btn_url').value.trim();

      retakeBtnConfig.text = document.getElementById('admin_retake_btn_text').value.trim();

      const fullConfig = {
        quizQuestions: quizQuestions,
        archetypeData: archetypeData,
        fbCtaConfig: fbCtaConfig,
        masterpackConfig: masterpackConfig,
        teaserConfig: teaserConfig,
        actionBtnConfig: actionBtnConfig,
        retakeBtnConfig: retakeBtnConfig
      };

      localStorage.setItem('ved_study_quiz_questions', JSON.stringify(quizQuestions));
      localStorage.setItem('ved_study_archetype_data', JSON.stringify(archetypeData));
      localStorage.setItem('ved_study_fb_cta_config', JSON.stringify(fbCtaConfig));
      localStorage.setItem('ved_study_masterpack_config', JSON.stringify(masterpackConfig));
      localStorage.setItem('ved_study_teaser_config', JSON.stringify(teaserConfig));
      localStorage.setItem('ved_study_action_btn_config', JSON.stringify(actionBtnConfig));
      localStorage.setItem('ved_study_retake_btn_config', JSON.stringify(retakeBtnConfig));

      saveAdminConfigToCloud(fullConfig);
      closeAdminModal();
    }

    function resetContentToDefault() {
      if (confirm("Are you sure you want to reset all questions and archetype details to default?")) {
        quizQuestions = JSON.parse(JSON.stringify(defaultQuizQuestions));
        archetypeData = JSON.parse(JSON.stringify(defaultArchetypeData));
        fbCtaConfig = JSON.parse(JSON.stringify(defaultFbCtaConfig));
        masterpackConfig = JSON.parse(JSON.stringify(defaultMasterpackConfig));
        teaserConfig = JSON.parse(JSON.stringify(defaultTeaserConfig));
        actionBtnConfig = JSON.parse(JSON.stringify(defaultActionBtnConfig));
        retakeBtnConfig = JSON.parse(JSON.stringify(defaultRetakeBtnConfig));

        localStorage.removeItem('ved_study_quiz_questions');
        localStorage.removeItem('ved_study_archetype_data');
        localStorage.removeItem('ved_study_fb_cta_config');
        localStorage.removeItem('ved_study_masterpack_config');
        localStorage.removeItem('ved_study_teaser_config');
        localStorage.removeItem('ved_study_action_btn_config');
        localStorage.removeItem('ved_study_retake_btn_config');

        const fullConfig = {
          quizQuestions: quizQuestions,
          archetypeData: archetypeData,
          fbCtaConfig: fbCtaConfig,
          masterpackConfig: masterpackConfig,
          teaserConfig: teaserConfig,
          actionBtnConfig: actionBtnConfig,
          retakeBtnConfig: retakeBtnConfig
        };

        saveAdminConfigToCloud(fullConfig);
        renderAdminQuestionsEditor();
      }
    }
  </script>
</body>
