<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>VectorEd Academy - Ultimate Study Technique Diagnostic</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome 6.4.0 CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Inter & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brandNavy: '#0B192C',
            brandDarkCard: '#1E293B',
            brandGold: '#F5A623',
            brandGoldHover: '#D98E19',
            brandLightCard: '#EBF3FE',
            brandSoftWhite: '#FCFAF2'
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Outfit', 'sans-serif']
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #0B192C;
      color: #F8FAFC;
      font-family: 'Inter', sans-serif;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
    }
    b, strong {
      font-weight: 800 !important;
      color: #FFFFFF !important;
    }
    i, em {
      font-style: italic !important;
    }
    .amber-gradient-btn {
      background: linear-gradient(135deg, #FFB200 0%, #F5A623 100%);
      color: #0F172A;
      transition: all 0.2s ease-in-out;
    }
    .amber-gradient-btn:hover:not(:disabled) {
      background: linear-gradient(135deg, #F5A623 0%, #E09000 100%);
      transform: translateY(-1px);
      box-shadow: 0 4px 15px rgba(245, 166, 35, 0.4);
    }
    .amber-gradient-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }
    .fb-blue-btn {
      background: linear-gradient(135deg, #1877F2 0%, #0d65d9 100%);
      color: #FFFFFF;
      transition: all 0.2s ease-in-out;
    }
    .fb-blue-btn:hover {
      background: linear-gradient(135deg, #166fe5 0%, #0a54b8 100%);
      box-shadow: 0 4px 15px rgba(24, 119, 242, 0.4);
    }
    .emerald-btn {
      background: linear-gradient(135deg, #10B981 0%, #059669 100%);
      color: #FFFFFF;
      transition: all 0.2s ease-in-out;
    }
    .emerald-btn:hover {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }
    .card-glass {
      background: rgba(30, 41, 59, 0.92);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .option-card {
      transition: all 0.2s ease-in-out;
      cursor: pointer;
    }
    .option-card:hover {
      border-color: #F5A623;
      background-color: rgba(245, 166, 35, 0.08);
    }
    .option-card.selected {
      border-color: #F5A623;
      background-color: rgba(245, 166, 35, 0.18);
      box-shadow: 0 0 12px rgba(245, 166, 35, 0.25);
    }
    .formatted-content {
      white-space: pre-line;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-amber-500 selection:text-navy-900">

  <!-- ================= HEADER SECTION ================= -->
  <header class="w-full bg-[#0B192C] border-b border-slate-800 sticky top-0 z-50 px-3 sm:px-4 py-3 shadow-md">
    <div class="max-w-xl mx-auto flex items-center justify-between">
      <!-- Logo and Title -->
      <div class="flex items-center space-x-2.5 sm:space-x-3">
        <img src="https://iili.io/ndL8PQj.png" alt="VectorEd Academy Logo" class="h-8 sm:h-9 w-auto object-contain">
        <div>
          <div class="font-display text-base sm:text-lg font-bold tracking-tight text-white leading-none">
            Vector<span class="text-amber-500">Ed</span> Academy
          </div>
          <div class="text-[10px] text-emerald-400 font-medium flex items-center space-x-1 mt-0.5">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="headerCloudStatus">☁️ Cloud Sync: Active</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons: Admin & Language Toggle -->
      <div class="flex items-center space-x-1.5 sm:space-x-2">
        <button onclick="openAdminModal()" class="flex items-center space-x-1 bg-slate-800/90 border border-slate-700 hover:border-amber-500/80 px-2.5 py-1.5 rounded-full text-xs font-semibold text-slate-300 transition-colors">
          <i class="fa-solid fa-lock text-amber-500 text-[11px]"></i>
          <span class="hidden sm:inline">Admin</span>
        </button>
        <button id="langToggleBtn" onclick="toggleLanguage()" class="flex items-center space-x-1.5 bg-slate-800 border border-slate-700 hover:border-amber-500 px-2.5 sm:px-3 py-1.5 rounded-full text-xs font-semibold text-slate-200 transition-colors">
          <i class="fa-solid fa-globe text-amber-500"></i>
          <span id="langToggleText">EN | Taglish</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTAINER ================= -->
  <main class="flex-grow flex items-center justify-center p-3 sm:p-4">
    <div class="w-full max-w-md sm:max-w-xl mx-auto">

      <!-- SCREEN 1: LEAD CAPTURE FORM -->
      <div id="screen1" class="card-glass rounded-2xl p-4 sm:p-8 shadow-2xl">
        <div class="text-center mb-5">
          <span class="inline-block px-3 py-1 rounded-full text-[11px] sm:text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 mb-2">
            <i class="fa-solid fa-graduation-cap mr-1"></i> Student Diagnostic Tool
          </span>
          <h1 id="screen1Title" class="font-display text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Ultimate Study Technique Diagnostic
          </h1>
          <p id="screen1Subtitle" class="text-slate-300 text-xs sm:text-sm mt-1.5">
            Identify your core learning bottlenecks and unlock the exact study methods tailored to your academic needs.
          </p>
        </div>

        <form id="leadForm" class="space-y-3.5" onsubmit="handleFormSubmit(event)">
          <div>
            <label for="fullName" class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
              Full Name <span class="text-amber-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                <i class="fa-regular fa-user"></i>
              </span>
              <input type="text" id="fullName" placeholder="e.g. Juan Dela Cruz" oninput="validateForm()" class="w-full pl-9 pr-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition">
            </div>
          </div>

          <div>
            <label for="email" class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
              Email Address <span class="text-amber-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                <i class="fa-regular fa-envelope"></i>
              </span>
              <input type="email" id="email" placeholder="student@university.edu.ph" oninput="validateForm()" class="w-full pl-9 pr-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition">
            </div>
            <p id="emailError" class="text-[11px] text-rose-400 mt-1 hidden">Please enter a valid email address.</p>
          </div>

          <div>
            <label for="phone" class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
              Cellphone Number <span class="text-amber-500">* (09XXXXXXXXX - 11 digits)</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                <i class="fa-solid fa-mobile-screen-button"></i>
              </span>
              <input type="tel" id="phone" maxlength="11" placeholder="09171234567" oninput="validateForm()" class="w-full pl-9 pr-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition">
            </div>
            <p id="phoneError" class="text-[11px] text-rose-400 mt-1 hidden">Must start with 09 and be exactly 11 digits.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label for="university" class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                University / College <span class="text-amber-500">*</span>
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                  <i class="fa-solid fa-building-columns"></i>
                </span>
                <input type="text" id="university" placeholder="e.g. DLSU, Mapua, UST" oninput="validateForm()" class="w-full pl-9 pr-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition">
              </div>
            </div>

            <div>
              <label for="yearLevel" class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
                Year Level <span class="text-amber-500">*</span>
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                  <i class="fa-solid fa-layer-group"></i>
                </span>
                <select id="yearLevel" onchange="validateForm()" class="w-full pl-9 pr-4 py-2.5 bg-slate-900/90 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-amber-500 transition appearance-none">
                  <option value="" disabled selected>Select Year</option>
                  <option value="Freshman">Freshman (1st Year)</option>
                  <option value="Sophomore">Sophomore (2nd Year)</option>
                  <option value="Junior">Junior (3rd Year)</option>
                  <option value="Senior">Senior (4th Year+)</option>
                </select>
                <span class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-400">
                  <i class="fa-solid fa-chevron-down text-xs"></i>
                </span>
              </div>
            </div>
          </div>

          <div>
            <label for="difficultSubjects" class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-1">
              Difficult Subjects for You <span class="text-amber-500">*</span>
            </label>
            <textarea id="difficultSubjects" rows="2" placeholder="e.g. Calculus, Physics, Accounting" oninput="validateForm()" class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition resize-none"></textarea>
          </div>

          <div class="pt-2">
            <button type="submit" id="startQuizBtn" disabled class="w-full py-3.5 px-6 rounded-xl font-bold text-slate-950 text-sm sm:text-base amber-gradient-btn shadow-lg flex items-center justify-center space-x-2">
              <span id="startBtnText">Start Diagnostic Quiz 🚀</span>
            </button>
          </div>
        </form>
      </div>

      <!-- SCREEN 2: STEP-BY-STEP DIAGNOSTIC QUIZ -->
      <div id="screen2" class="card-glass rounded-2xl p-4 sm:p-8 shadow-2xl hidden">
        <div class="mb-5">
          <div class="flex justify-between items-center mb-1.5">
            <span id="quizCounterText" class="text-xs font-semibold uppercase tracking-wider text-amber-400">
              Question 1 of 5
            </span>
            <span id="progressPercent" class="text-xs font-bold text-slate-400">
              20%
            </span>
          </div>
          <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden border border-slate-700">
            <div id="progressBar" class="bg-amber-500 h-2 rounded-full transition-all duration-300" style="width: 20%"></div>
          </div>
        </div>

        <div class="mb-5">
          <h2 id="questionCategory" class="text-[11px] font-bold text-amber-400/90 uppercase tracking-widest mb-1">
            Category Name
          </h2>
          <h3 id="questionText" class="text-base sm:text-lg font-bold text-white leading-snug formatted-content">
            Question prompt text will appear here...
          </h3>
        </div>

        <div id="optionsContainer" class="space-y-2.5 mb-6">
          <!-- Dynamic Options rendered via JS -->
        </div>

        <div class="flex items-center justify-between pt-3 border-t border-slate-800">
          <button id="prevBtn" onclick="prevQuestion()" class="px-3.5 py-2 rounded-lg bg-slate-800 border border-slate-700 text-slate-300 text-xs sm:text-sm font-semibold hover:bg-slate-700 transition disabled:opacity-30 disabled:cursor-not-allowed">
            <i class="fa-solid fa-arrow-left mr-1"></i> Back
          </button>
          
          <button id="nextBtn" onclick="nextQuestion()" disabled class="px-5 py-2.5 rounded-lg amber-gradient-btn text-slate-950 text-xs sm:text-sm font-bold shadow transition flex items-center space-x-2">
            <span id="nextBtnText">Next Question</span>
            <i id="nextBtnIcon" class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </div>

      <!-- SCREEN 3: 2-COLUMN RESULT & CTA SECTION -->
      <div id="screen3" class="card-glass rounded-2xl p-4 sm:p-8 shadow-2xl hidden">
        
        <div class="text-center mb-5">
          <span class="inline-block px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-2">
            <i class="fa-solid fa-circle-check mr-1"></i> Diagnostic Completed
          </span>
          <h2 class="font-display text-xl sm:text-2xl font-bold text-white">
            Your Diagnostic Archetype Profile
          </h2>
        </div>

        <!-- NEW 2-COLUMN ARCHETYPE LAYOUT -->
        <div class="bg-slate-900/90 border border-slate-700 rounded-xl overflow-hidden mb-5 shadow-inner">
          
          <!-- Top Section: Emoji, Badge, Title, Summary -->
          <div class="p-4 sm:p-5 text-center border-b border-slate-800">
            <div id="archetypeEmoji" class="text-5xl sm:text-6xl mb-3 filter drop-shadow inline-block">🧽</div>
            <div>
              <span id="archetypeBadge" class="px-2.5 py-0.5 rounded text-[10px] font-extrabold uppercase bg-amber-500 text-slate-950 inline-block mb-2">
                Primary Archetype
              </span>
            </div>
            <h3 id="archetypeTitle" class="text-xl sm:text-2xl font-black text-amber-400 font-display mb-3">
              Title Goes Here
            </h3>
            <div id="archetypeSummary" class="text-xs sm:text-sm text-slate-200 leading-relaxed bg-slate-800/50 p-3 sm:p-4 rounded-xl border border-slate-700/50 formatted-content max-w-lg mx-auto">
              Summary text loading...
            </div>
          </div>

          <!-- Bottom Section: The 2-Column Grid for Study Techniques -->
          <div class="p-4 sm:p-5 bg-amber-500/5">
            <h4 class="text-[11px] font-bold uppercase tracking-wider text-amber-400 flex items-center justify-center mb-4 text-center">
              <i class="fa-solid fa-layer-group mr-1.5"></i> Your Recommended Study Protocol
            </h4>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              <!-- Technique Column 1 -->
              <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-4 flex flex-col items-center text-center shadow-lg transition hover:border-amber-500/50">
                <img src="https://placehold.co/150x150/1E293B/F5A623?text=Method+1" alt="Technique 1" class="w-16 h-16 sm:w-20 sm:h-20 object-cover rounded-lg mb-3 shadow-md border border-slate-600">
                <h5 id="tech1Title" class="font-bold text-white text-sm mb-2">Technique 1 Title</h5>
                <p id="tech1Desc" class="text-xs text-slate-300 leading-relaxed formatted-content">Technique 1 description goes here.</p>
              </div>

              <!-- Technique Column 2 -->
              <div class="bg-slate-800/80 border border-slate-700 rounded-xl p-4 flex flex-col items-center text-center shadow-lg transition hover:border-amber-500/50">
                <img src="https://placehold.co/150x150/1E293B/F5A623?text=Method+2" alt="Technique 2" class="w-16 h-16 sm:w-20 sm:h-20 object-cover rounded-lg mb-3 shadow-md border border-slate-600">
                <h5 id="tech2Title" class="font-bold text-white text-sm mb-2">Technique 2 Title</h5>
                <p id="tech2Desc" class="text-xs text-slate-300 leading-relaxed formatted-content">Technique 2 description goes here.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Dynamic FB CONNECT CTA -->
        <div class="mb-5">
          <a id="fbConnectBtn" href="https://www.facebook.com/johnres.hipe.58/" target="_blank" rel="noopener noreferrer" class="w-full py-3.5 px-4 rounded-xl font-bold text-xs sm:text-sm fb-blue-btn shadow-lg flex items-center justify-center space-x-2 text-center">
            <i class="fa-brands fa-facebook-f text-base"></i>
            <span id="fbConnectText">Connect with Engr. Johnres Hipe on FB for your diagnostic breakdown</span>
          </a>
        </div>

        <!-- DYNAMIC HIGH YIELD ENERGY MASTERPACK & CURIOSITY TEASER CARD -->
        <div id="masterpackContainer" class="bg-gradient-to-br from-slate-800 to-slate-900 border-2 border-amber-500/60 rounded-xl p-4 sm:p-5 shadow-xl text-center space-y-3 mb-4">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-amber-500/20 text-amber-400">
            <i class="fa-solid fa-bolt text-lg"></i>
          </div>
          <h3 id="masterpackTitle" class="text-base sm:text-lg font-extrabold text-white font-display">
            High Yield Energy MasterPack 🚀
          </h3>
          <div id="masterpackInstruction" class="text-xs sm:text-sm text-slate-200 leading-relaxed max-w-sm mx-auto formatted-content">
            To claim your free VectorEd formula vaults, prerequisite cheat sheets, and board strategy materials, <strong class="text-amber-400">Message Our FB Page</strong> and type <span class="bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded font-mono font-bold">"DIAGNOSTICS"</span>.
          </div>

          <!-- CURIOSITY HOOK / SPECIAL OPPORTUNITY TEASER -->
          <div id="teaserBox" class="p-3 bg-amber-500/10 border border-amber-500/30 rounded-lg text-left text-xs text-amber-200 flex items-start space-x-2">
            <i class="fa-solid fa-gift text-amber-400 text-base mt-0.5 flex-shrink-0"></i>
            <div>
              <strong id="teaserTitle" class="text-amber-300 block font-semibold mb-0.5">🎁 Exclusive Student Opportunity Inside:</strong>
              <span id="teaserText" class="formatted-content">We have a special, limited-time 1-on-1 academic mentorship opportunity waiting for event attendees! Message our FB page now so we can share this special privilege with you.</span>
            </div>
          </div>

          <!-- Toast Notification for Copy Action -->
          <div id="copyToast" class="hidden bg-emerald-500/20 border border-emerald-500/50 text-emerald-300 text-xs py-2 px-3 rounded-lg font-semibold animate-pulse">
            <i class="fa-solid fa-check-circle mr-1"></i> Code copied! Opening FB Page...
          </div>

          <div class="pt-1">
            <a id="actionBtn" href="https://www.facebook.com/share/1NnxduVw9U/" target="_blank" rel="noopener noreferrer" onclick="copyAndOpenFB(event)" class="w-full py-3 px-5 rounded-xl font-extrabold text-xs sm:text-sm amber-gradient-btn shadow flex items-center justify-center space-x-2">
              <i class="fa-solid fa-paper-plane"></i>
              <span id="actionBtnText">Copy "DIAGNOSTICS" & Message Our Page</span>
            </a>
          </div>
        </div>

        <!-- Restart Diagnostic Link -->
        <div class="text-center pt-2">
          <button id="retakeBtn" onclick="resetDiagnostic()" class="text-xs text-slate-400 hover:text-amber-400 underline transition">
            <i class="fa-solid fa-rotate-left mr-1"></i> Retake Diagnostic Test
          </button>
        </div>

      </div>

    </div>
  </main>

  <!-- ================= ADMIN MODAL ================= -->
  <div id="adminModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-3 hidden">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
      <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950">
        <div class="flex items-center space-x-2">
          <i class="fa-solid fa-sliders text-amber-500"></i>
          <h3 class="font-display font-bold text-white text-base">VectorEd Admin Portal</h3>
        </div>
        <button onclick="closeAdminModal()" class="text-slate-400 hover:text-white text-lg px-2">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="p-4 sm:p-6 overflow-y-auto space-y-5 text-xs sm:text-sm text-slate-200">
        
        <!-- View 1: Admin Login View -->
        <div id="adminLoginView" class="space-y-4">
          <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700 space-y-3">
            <h4 class="font-bold text-white text-sm">Administrator Authentication</h4>
            <p class="text-slate-400 text-xs">Enter your administrator password to edit real-time questions, options, archetypes, CTAs, and layout settings.</p>
            <div>
              <label class="block text-[11px] text-slate-400 uppercase font-semibold mb-1">Admin Password</label>
              <input type="password" id="adminPasswordInput" placeholder="Enter Admin Password" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-white text-xs focus:outline-none focus:border-amber-500">
            </div>
            <p id="adminAuthError" class="text-xs text-rose-400 hidden">Incorrect password. Please try again.</p>
            <button onclick="authenticateAdmin()" class="w-full py-2.5 rounded-lg amber-gradient-btn text-slate-950 font-bold">
              Authenticate & Access
            </button>
          </div>
        </div>

        <!-- View 2: Admin Dashboard (Content Editor & Settings) -->
        <div id="adminDashboardView" class="hidden space-y-6">
          <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700 space-y-2">
            <div class="flex justify-between items-center">
              <h4 class="font-bold text-amber-400 text-xs sm:text-sm flex items-center">
                <i class="fa-solid fa-cloud-check mr-1.5 text-emerald-400"></i> Cloud Database Connection
              </h4>
              <span class="text-[10px] bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded font-mono">Google Sheets Active</span>
            </div>
            <p class="text-slate-400 text-xs">Test sending a sample ping lead to verify Google Sheets Web App connectivity in real-time.</p>
            <div class="pt-1 flex items-center space-x-2">
              <button onclick="testCloudConnection()" class="py-2 px-4 rounded-lg bg-slate-700 hover:bg-slate-600 border border-slate-600 text-white font-bold text-xs transition flex items-center">
                <i class="fa-solid fa-paper-plane mr-1.5 text-amber-400"></i> Send Test Entry to GSheets
